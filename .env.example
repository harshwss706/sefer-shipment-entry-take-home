# Optional: enables structured extraction for unfamiliar layouts. Documents' text
# is sent to this provider only when a key is configured. Never exposed to browser.
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3001
# Keep default loopback binding for local use. Docker uses 0.0.0.0.
HOST=127.0.0.1
